@article{souren2022,
  title = {Cell Line Authentication: A Necessity for Reproducible Biomedical Research},
  shorttitle = {Cell Line Authentication},
  author = {Souren, Nicole Y. and Fusenig, Norbert E. and Heck, Stefanie and Dirks, Wilhelm G. and {Capes-Davis}, Amanda and Bianchini, Franca and Plass, Christoph},
  year = 2022,
  month = jul,
  journal = {The EMBO journal},
  volume = {41},
  number = {14},
  pages = {e111307},
  issn = {1460-2075},
  doi = {10.15252/embj.2022111307},
  abstract = {Immortalized or continuous cell lines are invaluable tools in basic and preclinical research. However, the widespread use of misidentified cell lines is a serious threat to scientific reproducibility. Based on the experiences of mandatory cell line authentication at the International Journal of Cancer (IJC), we provide an overview of the issues pertinent to misidentified cell lines and discuss available solutions. We also summarize the lessons learned, revealing that at least 5\% of the human cell lines used in manuscripts considered for peer review are misidentified. About 4\% of the considered manuscripts are rejected for severe cell line problems, and most are subsequently published in other journals. In order to diminish such malpractice and its consequences for the scientific record, we postulate that strict multi-layered quality control is essential. Besides journals and publishers, we encourage scientists, research institutions, and funders to take action on the matter and revise their respective policies. Hence, we provide concrete recommendations on introducing regular authentication schemes and staff training, and discuss future steps for enhancing good cell culture practices.},
  langid = {english},
  pmcid = {PMC9289526},
  pmid = {35758134},
  keywords = {Biomedical Research,Cell Culture Techniques,Cell Line,Cell Line Authentication,Cell line cross-contamination,good scientific practice,Humans,International Journal of Cancer,misidentified cell lines,Reproducibility of Results,research integrity},
  file = {/Users/nattawasprakinkij/Zotero/storage/W8V8DBKI/Souren et al. - 2022 - Cell line authentication a necessity for reproducible biomedical research.pdf}
}

